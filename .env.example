# Copie para .env e preencha com seus valores reais.
# Em desenvolvimento, NÃO precisa criar .env — os defaults do settings.py funcionam.

# === Obrigatórios em PRODUÇÃO ===

# Gere uma chave forte (50+ chars). Em Python:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole-aqui-uma-chave-aleatoria-de-50-caracteres

# Em produção, sempre False.
DEBUG=False

# Hosts/domínios autorizados, separados por espaço ou vírgula.
# Exemplo com sslip.io (sem domínio próprio):
#   Se seu IP é 203.0.113.42 → use 203-0-113-42.sslip.io
ALLOWED_HOSTS=203-0-113-42.sslip.io 203.0.113.42

# Origens autorizadas para POSTs CSRF (precisa do https:// na frente).
CSRF_TRUSTED_ORIGINS=https://203-0-113-42.sslip.io


# === Opcionais ===

# Forçar redirect HTTP→HTTPS no Django (ative apenas se NGINX já estiver com SSL).
# Default: True em produção.
SECURE_SSL_REDIRECT=True

# HSTS — número de segundos. 0 desativa. Use 31536000 (1 ano) só após confirmar HTTPS estável.
SECURE_HSTS_SECONDS=0

# Caminho absoluto da pasta com os PNGs do pipeline.
# Default: ../graficos relativo ao webapp/
# GRAFICOS_DIR=/var/www/educasp/graficos

# PostgreSQL — opcional. Se vazio, usa SQLite (suficiente para o app).
# Requer: pip install dj-database-url psycopg2-binary
# DATABASE_URL=postgres://user:senha@localhost:5432/educasp
